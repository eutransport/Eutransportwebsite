# ============================================================
# E&U Transport — installer configuratie
# Kopieer naar .env en pas aan waar nodig
# ============================================================

# Naam van het gedeelde Docker-netwerk waar Nginx Proxy Manager aan hangt.
# Voor de bestaande tmsapp-setup is dit 'tms_external'.
# Check met: docker network ls
PROXY_NETWORK=tms_external

# Docker Compose project-naam (verandert alleen de labels/prefix)
STACK_NAME=eutransport
